{
  "name": "auth-session-create",
  "request": {
    "method": "POST",
    "path": "/v1/auth/session",
    "body": {
      "auth0_access_token": "fixture-identity-token",
      "time_zone": "America/New_York",
      "device_name": "iPhone 17 Pro"
    }
  },
  "response": {
    "status": 201,
    "body": {
      "session_token": "fixture-session-token-not-a-secret",
      "expires_at": "2027-02-24T23:00:00Z",
      "user": {
        "id": "11111111-1111-4111-8111-111111111111",
        "email": "matt@example.com",
        "display_name": "Matt",
        "pursuer": "goose",
        "time_zone": "America/New_York",
        "day_start": "06:00",
        "day_end": "00:00",
        "pending": null,
        "created_at": "2026-10-22T14:00:00Z"
      }
    }
  }
}
